{
  "name": "atomic-sdlc",
  "version": "0.3.3",
  "description": "A modular suite of high-precision, atomic AI agent skills for the SDLC",
  "repository": "https://github.com/boxheed/atomic-sdlc-extension",
  "homepage": "https://github.com/boxheed/atomic-sdlc-extension",
  "contextFileName": "GEMINI.md",
  "commands": {
    "atomic:build": "commands/atomic/build.toml",
    "atomic:build:audit-docs": "commands/atomic/build/audit-docs.toml",
    "atomic:build:audit": "commands/atomic/build/audit.toml",
    "atomic:build:docs": "commands/atomic/build/docs.toml",
    "atomic:build:integrate": "commands/atomic/build/integrate.toml",
    "atomic:build:refactor": "commands/atomic/build/refactor.toml",
    "atomic:build:write": "commands/atomic/build/write.toml",
    "atomic:design": "commands/atomic/design.toml",
    "atomic:design:api": "commands/atomic/design/api.toml",
    "atomic:design:architect": "commands/atomic/design/architect.toml",
    "atomic:design:audit-ux": "commands/atomic/design/audit-ux.toml",
    "atomic:design:audit": "commands/atomic/design/audit.toml",
    "atomic:design:data": "commands/atomic/design/data.toml",
    "atomic:design:ui": "commands/atomic/design/ui.toml",
    "atomic:discovery": "commands/atomic/discovery.toml",
    "atomic:discovery:audit": "commands/atomic/discovery/audit.toml",
    "atomic:discovery:criteria": "commands/atomic/discovery/criteria.toml",
    "atomic:discovery:extract": "commands/atomic/discovery/extract.toml",
    "atomic:discovery:limits": "commands/atomic/discovery/limits.toml",
    "atomic:discovery:slice": "commands/atomic/discovery/slice.toml",
    "atomic:discovery:spec": "commands/atomic/discovery/spec.toml",
    "atomic:ops": "commands/atomic/ops.toml",
    "atomic:ops:analyze": "commands/atomic/ops/analyze.toml",
    "atomic:ops:monitor": "commands/atomic/ops/monitor.toml",
    "atomic:ops:post-mortem": "commands/atomic/ops/post-mortem.toml",
    "atomic:ship": "commands/atomic/ship.toml",
    "atomic:ship:cicd": "commands/atomic/ship/cicd.toml",
    "atomic:ship:infra": "commands/atomic/ship/infra.toml",
    "atomic:ship:secure": "commands/atomic/ship/secure.toml",
    "atomic:utility:format-md": "commands/atomic/utility/format-md.toml",
    "atomic:verify": "commands/atomic/verify.toml",
    "atomic:verify:audit": "commands/atomic/verify/audit.toml",
    "atomic:verify:profile": "commands/atomic/verify/profile.toml",
    "atomic:verify:stress": "commands/atomic/verify/stress.toml",
    "atomic:verify:write": "commands/atomic/verify/write.toml"
  },
  "policies": [
    "policies/artifact_safety.toml",
    "policies/git_safety.toml"
  ],
  "excludeTools": [
    "run_shell_command(shutdown*)",
    "run_shell_command(reboot*)",
    "run_shell_command(halt*)",
    "run_shell_command(systemctl stop*)",
    "run_shell_command(systemctl restart*)",
    "run_shell_command(systemctl disable*)",
    "run_shell_command(service stop*)",
    "run_shell_command(service restart*)",
    "run_shell_command(sudo *)",
    "run_shell_command(rm -rf /)",
    "run_shell_command(rm -rf /*)",
    "run_shell_command(mkfs*)",
    "run_shell_command(dd if=*)",
    "run_shell_command(chmod 777 *)"
  ]
}
